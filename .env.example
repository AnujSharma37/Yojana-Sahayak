# Copy to .env and fill in. Never commit .env.
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgresql://neondb_owner:npg_6aTw5zvXPyeW@ep-snowy-moon-aojnw1dy-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- AI provider (server-side only). Leave keys blank to run in "AI unavailable" fallback mode. ---
# Choose "gemini" or "anthropic". If empty, whichever key below is filled in is used (Gemini first).
LLM_PROVIDER=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Model id for the chosen provider, e.g. a Gemini model id or the current Claude Sonnet model id
LLM_MODEL=""
# Daily cap on LLM calls per server instance (budget guard)
DAILY_LLM_REQUEST_LIMIT="500"
# Per-client daily AI call cap (default 40)
DAILY_LLM_PER_CLIENT_LIMIT=40

# Show schemes still marked needs_verification on Explore, clearly labelled as drafts.
# Chatbot and eligibility checker never use them. Keep "false" for a public production site.
SHOW_UNVERIFIED="false"
